rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "mpBZ0ta8CJcyuQf10gS70BVBGcC2";
    }

    // Corrigido de /produtos/ para /products/
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Corrigido de /carrossel/ para /carousel/
    match /carousel/{slideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}