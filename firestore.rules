rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leitura livre para o público carregar a loja (index.html)
    match /carousel/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /products/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}